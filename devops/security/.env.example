# =============================================================================
# Environment Variables — Production
# Copy to .env.production and fill values
# =============================================================================

# App
NODE_ENV=production
APP_URL=https://inomtechs.com

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key-here

# Docker Registry
REGISTRY=ghcr.io
REPOSITORY=inomtechs/inomtechs-site
TAG=latest

# SSL
SSL_EMAIL=admin@inomtechs.com
SSL_DOMAIN=inomtechs.com

# Monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-please
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/here
PAGERDUTY_ROUTING_KEY=your-pagerduty-key

# Backups
S3_BUCKET=inomtechs-backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Deployment
STAGING_HOST=staging.inomtechs.com
PRODUCTION_HOST=inomtechs.com
SSH_PRIVATE_KEY=your-ssh-private-key
